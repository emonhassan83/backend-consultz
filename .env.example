# Copy this file to .env on the server and fill in the real values.
# Never commit .env. Values marked (required) must be set for production.

# ---------------------------------------------------------------
# App and server
# ---------------------------------------------------------------
NODE_ENV=production                 # production on the server, development locally
PORT=5000                           # HTTP API port
SOCKET_PORT=4000                    # Socket.IO port (separate from PORT)
IP=0.0.0.0                          # Interface to listen on
SERVER_URL=https://api.example.com/api/v1   # (required) public API URL, used for Stripe Connect return links
APP_URL=https://app.example.com
CLIENT_URL=https://dashboard.example.com

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER/DB_NAME   # (required)

# ---------------------------------------------------------------
# Auth (JWT and bcrypt)
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Changing a secret logs everyone out.
# ---------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=enter_a_long_random_secret     # (required)
JWT_REFRESH_SECRET=enter_another_long_random_secret   # (required)
JWT_ACCESS_EXPIRE_IN=7d
JWT_REFRESH_EXPIRE_IN=30d
# OTP token lifetime (optional, default 7d)
# JWT_ACCESS_EXPIRES_IN=7d

# Password for the admin account created by `npm run seed:admin`
ADMIN_PASS=enter_a_strong_admin_password

# ---------------------------------------------------------------
# Email: Brevo transactional SMTP (OTP, booking, payment, alerts)
# Brevo > Settings > SMTP & API > SMTP tab.
# BREVO_SMTP_LOGIN looks like 8a1b2c001@smtp-brevo.com
# BREVO_SMTP_KEY is the SMTP key (xsmtpsib-...), NOT the API key (xkeysib-...)
# The consultz.com domain (SPF/DKIM) and the sender must be verified in Brevo.
# Check after restart: npm run email:test -- you@example.com
# ---------------------------------------------------------------
BREVO_SMTP_LOGIN=enter_brevo_smtp_login        # (required)
BREVO_SMTP_KEY=enter_brevo_smtp_key            # (required)
EMAIL_FROM_ADDRESS=info@consultz.com           # (required) sender users see; also the support address
EMAIL_FROM_NAME=Consultz
# Optional. Defaults with Brevo: smtp-relay.brevo.com, 587, STARTTLS.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Old Gmail setup. Used only while BREVO_SMTP_LOGIN / BREVO_SMTP_KEY are empty.
# APP_PASS must be a Gmail App Password (2FA on).
# EMAIL=your_gmail_address
# APP_PASS=your_gmail_app_password

# Where new post reports are emailed (comma-separated).
# Empty = the admin accounts' own emails.
ADMIN_NOTIFY_EMAIL=moderation@consultz.com

# ---------------------------------------------------------------
# Stripe (payments, refunds, Connect payouts)
# Use sk_live_ / pk_live_ in production, sk_test_ / pk_test_ elsewhere.
# ---------------------------------------------------------------
STRIPE_API_KEY=pk_live_xxx                     # publishable key
STRIPE_API_SECRET=sk_live_xxx                  # (required) secret key
PAYMENT_SUCCESS_URL=https://app.example.com/success
PAYMENT_CANCEL_URL=https://app.example.com/cancel
RESET_PASS_LINK=https://app.example.com/reset-password

# ---------------------------------------------------------------
# File storage: AWS S3 or DigitalOcean Spaces
# ---------------------------------------------------------------
S3_BUCKET_ACCESS_KEY=enter_access_key          # (required)
S3_BUCKET_SECRET_ACCESS_KEY=enter_secret_key   # (required)
AWS_REGION=enter_region                        # e.g. eu-west-2, or nyc3 for Spaces
AWS_BUCKET_NAME=enter_bucket_name              # (required)
SPACES_API=https://REGION.digitaloceanspaces.com   # Spaces endpoint; leave empty for AWS S3
S3_API=https://REGION.digitaloceanspaces.com
S3_BASE_URL=https://BUCKET.REGION.digitaloceanspaces.com   # (required) public URL prefix of uploaded files

# ---------------------------------------------------------------
# Twilio (phone OTP by SMS)
# ---------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # (required)
TWILIO_AUTH_TOKEN=enter_twilio_auth_token               # (required)
TWILIO_PHONE_NUMBER=+440000000000                       # (required) sender number, international format

# ---------------------------------------------------------------
# Agora (video calls)
# ---------------------------------------------------------------
AGORA_APP_ID=enter_agora_app_id                # (required)
AGORA_APP_CERTIFICATE=enter_agora_certificate  # (required)
AGORA_TOKEN_EXPIRE=3600                        # seconds

# ---------------------------------------------------------------
# Firebase (push notifications). From the service-account JSON.
# Keep FIREBASE_PRIVATE_KEY in quotes, with \n for the line breaks.
# ---------------------------------------------------------------
FIREBASE_PROJECT_ID=enter_project_id
FIREBASE_PRIVATE_KEY_ID=enter_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nenter_key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@PROJECT.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=enter_client_id
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/ENCODED_CLIENT_EMAIL

# ---------------------------------------------------------------
# Apple APNs (iOS VoIP call pushes)
# Also put the key file on the server at certs/AuthKey_<APNS_KEY_ID>.p8
# ---------------------------------------------------------------
APNS_KEY_ID=enter_key_id
APNS_TEAM_ID=enter_team_id
APNS_BUNDLE_ID=com.example.app
# true = App Store / TestFlight, false = Xcode debug builds. Default: NODE_ENV=production
APNS_PRODUCTION=true

# ---------------------------------------------------------------
# VAT number lookup (optional). Empty = local VAT table only.
# ---------------------------------------------------------------
APIFREAKS_KEY=
