# Change this file to .env and changes your creanditials
NODE_ENV="development"
PORT=5000
SOCKET_PORT=4000

# Database and Server URL
SERVER_URL=enter_your_server_url
DATABASE_URL=enter_your_db_url

# Authentication jwt and bcrypt
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=c362d2567fd4a403fe0e4352d984523ef45cfgff54525452bdf85c43d22bf6935eb31b3bc7c0580a1f4556315548cc145215225
JWT_REFRESH_SECRET=23ef450e4352d9845feb31b3bc7c0580a1fcfgc362d2567fd4a403fe455f54525452bdf85c43d22bf69356315548cc145215225
JWT_ACCESS_EXPIRE_IN="7d"
JWT_REFRESH_EXPIRE_IN="30d"

# Email (Brevo transactional SMTP)
# Brevo > Settings > SMTP & API > SMTP tab.
# BREVO_SMTP_LOGIN looks like 8a1b2c001@smtp-brevo.com
# BREVO_SMTP_KEY is the SMTP key (xsmtpsib-...), NOT the API key (xkeysib-...)
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# The sender users see. Must be a verified sender / domain in Brevo.
EMAIL_FROM_ADDRESS=info@consultz.com
EMAIL_FROM_NAME=Consultz
# Optional. Defaults with Brevo: smtp-relay.brevo.com, 587, STARTTLS.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# Check the setup: npm run email:test -- you@example.com

# Old Gmail setup. Used only while the two BREVO_ values above are empty.
EMAIL=enter_your_email
APP_PASS=enter_your_app_pass
ADMIN_PASS=admin123

# Stripe API Key and Secret
STRIPE_API_KEY=enter_your_stripe_api_key
STRIPE_API_SECRET=enter_your_stripe_api_secret

# Client URL and Payment URLs
CLIENT_URL="http://localhost:3000"
PAYMENT_SUCCESS_URL="http://localhost:3000/success"
PAYMENT_CANCEL_URL="http://localhost:3000/cancel"
RESET_PASS_LINK="http://localhost:3000/reset-password"

# AWS S3 Bucket Credentials
S3_BUCKET_ACCESS_KEY=enter_your_S3_BUCKET_ACCESS_KEY
S3_BUCKET_SECRET_ACCESS_KEY=enter_your_S3_BUCKET_SECRET_ACCESS_KEY
AWS_REGION=enter_your_AWS_REGION
AWS_BUCKET_NAME=enter_your_AWS_BUCKET_NAME

# Admin alerts (new post reports). Comma-separated; defaults to admin account emails
ADMIN_NOTIFY_EMAIL=
